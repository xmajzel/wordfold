# Public Expo client configuration. These values are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_POWERSYNC_URL=https://example.powersync.com
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_PRONUNCIATION_NEURAL_PREVIEW_ENABLED=false
EXPO_PUBLIC_PRONUNCIATION_PRIVATE_PREVIEW_ENABLED=false

# Local infrastructure credentials only. Never use EXPO_PUBLIC_ for these values.
SUPABASE_DB_PASSWORD=
POWERSYNC_DB_PASSWORD=

# Optional for non-interactive PowerSync Cloud CLI usage.
PS_ADMIN_TOKEN=
