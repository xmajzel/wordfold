AZURE_SPEECH_KEY=replace-with-local-secret
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_TIER=S0

# Feedback notifications: server-only secrets; never use EXPO_PUBLIC_ for these.
RESEND_FEEDBACK_API_KEY=replace-with-local-secret
FEEDBACK_FROM_EMAIL="Wordfold <notifications@feedback.wordfold.app>"
FEEDBACK_WORKER_SECRET=replace-with-a-random-secret

PRONUNCIATION_USER_HOURLY_REQUEST_LIMIT=20
PRONUNCIATION_USER_DAILY_CHARACTER_LIMIT=1000
PRONUNCIATION_GLOBAL_DAILY_CHARACTER_LIMIT=10000

# Local fake-provider integration only. Never enable this in production.
PRONUNCIATION_FAKE_PROVIDER=false
# AZURE_SPEECH_ENDPOINT=http://host.docker.internal:8787/cognitiveservices/v1

# AI vocabulary: server-only credentials, configured in Supabase Edge Function secrets.
OPENAI_API_KEY=
REVENUECAT_SECRET_API_KEY=
AI_WORD_MODEL=gpt-5.6-sol
