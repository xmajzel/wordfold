    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-intent-launcher": "~56.0.4",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.18",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "expo-widgets": "~56.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-android-widget": "^0.21.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-purchases": "^10.7.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@google-cloud/text-to-speech": "6.4.1",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "jest-expo": "~56.0.5",
    "powersync": "0.10.0",
    "supabase": "2.109.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning",
    "powersync:validate": "powersync validate",
    "powersync:deploy": "powersync deploy",
    "powersync:deploy:sync": "powersync deploy sync-config",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "build:cefr": "node scripts/build-cefr-catalog.mjs",
    "build:cefr-translations": "python3 scripts/build-cefr-translations.py",
    "build:wordnet": "node scripts/build-wordnet.mjs",
    "build:personal-vocabulary": "node scripts/build-personal-vocabulary.mjs",
    "pronunciation:bakeoff": "node scripts/pronunciation-bakeoff.mjs",
    "pronunciation:bakeoff:validate": "node scripts/pronunciation-bakeoff.mjs validate",
    "pronunciation:bakeoff:plan": "node scripts/pronunciation-bakeoff.mjs plan",
    "pronunciation:review": "node scripts/pronunciation-review-server.mjs",
    "pronunciation:catalog-sql": "node scripts/build-pronunciation-catalog-sql.mjs",
    "pronunciation:backfill": "node scripts/pronunciation-backfill.mjs",
    "pronunciation:backfill:plan": "node scripts/pronunciation-backfill.mjs plan",
    "pronunciation:backfill:restore-limits": "node scripts/pronunciation-backfill.mjs restore-limits",
    "pronunciation:offline-manifest": "node scripts/pronunciation-offline-manifest.mjs",
    "pronunciation:offline-manifest:export": "node scripts/pronunciation-offline-manifest.mjs export --linked",
    "pronunciation:offline-manifest:verify": "node scripts/pronunciation-offline-manifest.mjs verify"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/features/widgets/widget-sync$": "<rootDir>/src/features/widgets/widget-sync.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/modules/"
    ]
  },
  "private": true
}
